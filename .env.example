# Copy to .env and fill in. Never commit .env.
APP_ENV=development
APP_NAME=SentinelForge
API_KEY=change-me
CORS_ORIGINS=http://localhost:5173,http://localhost:8501
DATA_DIR=./data
MAX_UPLOAD_MB=5
# Directory the MCP tools may inspect (never anything outside it)
WORKSPACE_ROOT=./samples/workspace
MAX_READ_BYTES=200000
TOOL_TIMEOUT_SECONDS=10
# Local embedding model (downloaded once by: python -m app.rag.warmup)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MODEL_CACHE_DIR=./models
RAG_TOOL_TIMEOUT_SECONDS=120
CHUNK_MAX_CHARS=1000
# LLM provider: demo (no external calls) or groq (sends prompts to Groq)
LLM_PROVIDER=demo
GROQ_API_KEY=
GROQ_MODEL=

# Hard limit for one agent run (seconds)
RUN_TIMEOUT_SECONDS=300
# Runs allowed in queued/running at once
MAX_ACTIVE_RUNS=3
# Sandbox test timeout (seconds)
SANDBOX_TIMEOUT_SECONDS=60
