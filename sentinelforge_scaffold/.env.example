# Copy to .env and fill in. Never commit .env.
APP_ENV=development
APP_NAME=SentinelForge
API_KEY=change-me
CORS_ORIGINS=http://localhost:5173,http://localhost:8501
DATA_DIR=./data
MAX_UPLOAD_MB=5
# LLM provider: demo (no external calls) or groq (sends prompts to Groq)
LLM_PROVIDER=demo
GROQ_API_KEY=
GROQ_MODEL=
